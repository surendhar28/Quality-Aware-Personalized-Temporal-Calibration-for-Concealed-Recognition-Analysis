# GazeGuard AI Environment Configuration
PROJECT_NAME="GazeGuard AI"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration
DATABASE_URL="sqlite:///./backend/app/database/gazeguard.db"

# Data Paths
RAW_DATA_DIR="./data/raw"
PROCESSED_DATA_DIR="./data/processed"
SYNTHETIC_DATA_DIR="./data/synthetic"
EXPERIMENT_RESULTS_DIR="./experiments/results"

# Primary Dataset Settings (Zenodo Record 18525952)
ZENODO_RECORD_ID="18525952"
ZENODO_DOI="10.5281/zenodo.18525952"

# Security & Privacy Settings
STORE_RAW_VIDEO=false
PSEUDONYMIZE_IDS=true
DATA_RETENTION_DAYS=30
